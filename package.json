{
  "name": "ci360-productivity-suite",
  "version": "1.5.6",
  "description": "CI360 Productivity Intelligence - Node.js Express backend API & Vite web frontend",
  "main": "backend/server.js",
  "private": true,
  "workspaces": [
    "backend",
    "web"
  ],
  "scripts": {
    "postinstall": "npm install --prefix web --include=dev && npm install --prefix backend",
    "build": "npm install --prefix web --include=dev && cd web && npx vite build",
    "start": "node backend/server.js",
    "dev:backend": "cd backend && npm run dev",
    "dev:web": "cd web && npm run dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:web\"",
    "services": "node backend/create_services.js",
    "clients": "node backend/create_clients.js",
    "team": "node backend/create_team.js",
    "clean": "cd backend && npm run clean"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.0.0",
    "mongoose": "^8.24.8",
    "vite": "^6.4.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "overrides": {
    "proxy-addr": "^2.0.8",
    "body-parser": "^1.20.9",
    "vite": "^6.4.4",
    "follow-redirects": "^1.16.2",
    "shell-quote": "^1.11.0",
    "source-map-js": "^1.2.2",
    "esbuild": "^0.28.1",
    "minimatch": "^11.0.1",
    "brace-expansion": "^5.0.12",
    "qs": "^6.16.1",
    "mongoose": "^8.24.8"
  }
}
