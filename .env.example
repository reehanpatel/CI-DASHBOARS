# Copy this file to .env and fill in your own values
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ci360?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# Used only by seed.js to create the first Super Admin account
SEED_SUPERADMIN_EMAIL=admin@ci360.local
SEED_SUPERADMIN_PASSWORD=ChangeMe123!
